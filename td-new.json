{
  "containerDefinitions": [
    {
      "name": "api",
      "image": "897545368119.dkr.ecr.us-east-2.amazonaws.com/rangley-api:vapor-20250823200545",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "api-8080-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "VAPOR_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "8080"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:897545368119:secret:vapor/dbRangley-connection-t3nocV:DB_HOST::"
        },
        {
          "name": "DB_PORT",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:897545368119:secret:vapor/dbRangley-connection-t3nocV:DB_PORT::"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:897545368119:secret:vapor/dbRangley-connection-t3nocV:DB_NAME::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:897545368119:secret:vapor/dbRangley-connection-t3nocV:DB_USER::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-2:897545368119:secret:vapor/dbRangley-connection-t3nocV:DB_PASSWORD::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/rangley-api-prod",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "api"
        }
      },
      "systemControls": []
    }
  ],
  "family": "rangley-api-prod",
  "taskRoleArn": "arn:aws:iam::897545368119:role/rangley-ecs-exec-prod",
  "executionRoleArn": "arn:aws:iam::897545368119:role/rangley-ecs-exec-prod",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "enableFaultInjection": false
}
